<?xml version="1.0" encoding="UTF-8"?>
<config
    xmlns="http://www.ehcache.org/v3"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:jsr107="http://www.ehcache.org/v3/jsr107"
    xsi:schemaLocation="
      http://www.ehcache.org/v3 https://www.ehcache.org/schema/ehcache-core.xsd
      http://www.ehcache.org/v3/jsr107 https://www.ehcache.org/schema/ehcache-107-ext.xsd">

  <service>
    <jsr107:defaults enable-management="true" enable-statistics="true"/>
  </service>

  <cache alias="default-read-mostly">
    <key-type>java.lang.Object</key-type>
    <value-type>java.lang.Object</value-type>
    <expiry>
      <ttl unit="minutes">15</ttl>
    </expiry>
    <resources>
      <heap unit="kB">10000</heap>
    </resources>
  </cache>

  <cache-template name="reference-entity-template">
    <key-type>java.lang.Object</key-type>
    <value-type>java.lang.Object</value-type>
    <expiry>
      <ttl unit="minutes">60</ttl>
    </expiry>
    <resources>
      <heap unit="kB">5000</heap>
    </resources>
  </cache-template>

  <cache alias="ru.kavader.arepos.model.Notations" uses-template="reference-entity-template"/>
  <cache alias="ru.kavader.arepos.model.NodeTypes" uses-template="reference-entity-template"/>
  <cache alias="ru.kavader.arepos.model.LinkTypes" uses-template="reference-entity-template"/>
</config>
